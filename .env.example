# Copiá este archivo como .env y descomentá lo que necesites. Se lee solo al hacer npm start / npm run track.

# Código postal para disponibilidad en Carrefour y Día (por defecto 1425)
#CP=1425

# Sucursal de Coto para precios y stock (por defecto 200)
#COTO_STORE=200

# Si Coto responde error 401/403: cambió su clave de búsqueda. Se ve en DevTools > Network > pedido a cnstrc.com (parámetro key=)
#COTO_KEY=

# Promos de Disco: ya vienen activas con el seller de Jumbo (comparadas con su web: coinciden).
# Si algún día conseguís su seller propio, ponelo acá (deja de descartar los grupos jumbo_prime y sgc).
#DISCO_PROMO_SELLER=
# Promos de Vea: ya vienen activas con su seller propio (jumboargentinav700cordoba700, verificado contra su web).
# NO uses el seller de Jumbo para Vea: mostraba una promo que Vea no tenía.
#VEA_PROMO_SELLER=

# Limitar las tiendas que se consultan (más rápido)
#TIENDAS_ACTIVAS=carrefour,dia,coto,jumbo

# Abrir el servidor a tu red (por ejemplo para usarlo desde el celular). Sin contraseña: solo en una red de confianza.
#HOST=0.0.0.0
#PORT=3000
